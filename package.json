{
  "name": "wisprcheap",
  "version": "0.1.0",
  "description": "Push-to-talk dictation: hold a hotkey, speak, release -> transcribed + polished text pasted at the cursor.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/launch.ts",
    "start:fg": "node --disable-warning=ExperimentalWarning src/main.ts",
    "stop": "node --disable-warning=ExperimentalWarning src/launch.ts --stop",
    "shortcut": "node --disable-warning=ExperimentalWarning scripts/create-shortcut.ts",
    "devices": "node --disable-warning=ExperimentalWarning src/devices.ts",
    "stats": "node --disable-warning=ExperimentalWarning src/stats.ts",
    "test:smoke": "node --disable-warning=ExperimentalWarning scripts/smoke.ts",
    "test:e2e": "node --disable-warning=ExperimentalWarning scripts/e2e.ts",
    "typecheck": "tsc --noEmit"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@picovoice/pvrecorder-node": "^1.2.9",
    "@picovoice/pvspeaker-node": "^1.0.3",
    "clipboardy": "^5.3.2",
    "uiohook-napi": "^1.5.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
